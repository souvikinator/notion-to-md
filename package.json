{
  "name": "notion-to-md",
  "version": "4.0.0-beta.0",
  "description": "Convert Notion pages and databases to Markdown, MDX, HTML or any format you write a renderer for.",
  "keywords": [
    "notion",
    "notion-api",
    "markdown",
    "mdx",
    "html",
    "notion-to-md",
    "notion-export",
    "static-site",
    "cms"
  ],
  "author": "Souvik Kar Mahapatra <souvikat001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/souvikinator/notion-to-md.git"
  },
  "bugs": {
    "url": "https://github.com/souvikinator/notion-to-md/issues"
  },
  "homepage": "https://github.com/souvikinator/notion-to-md#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./build/markdown.d.ts",
        "default": "./build/markdown.js"
      },
      "require": {
        "types": "./build/markdown.d.cts",
        "default": "./build/markdown.cjs"
      }
    },
    "./mdx": {
      "import": {
        "types": "./build/mdx.d.ts",
        "default": "./build/mdx.js"
      },
      "require": {
        "types": "./build/mdx.d.cts",
        "default": "./build/mdx.cjs"
      }
    },
    "./html": {
      "import": {
        "types": "./build/html.d.ts",
        "default": "./build/html.js"
      },
      "require": {
        "types": "./build/html.d.cts",
        "default": "./build/html.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./build/plugins.d.ts",
        "default": "./build/plugins.js"
      },
      "require": {
        "types": "./build/plugins.d.cts",
        "default": "./build/plugins.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./build/node.d.ts",
        "default": "./build/node.js"
      },
      "require": {
        "types": "./build/node.d.cts",
        "default": "./build/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "npm run build && publint --strict && attw --pack . --profile node16 && node scripts/check-treeshake.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:package",
    "prepare": "husky",
    "prepublishOnly": "npm run check"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,html}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@notionhq/client": ">=5.0.0"
  },
  "dependencies": {
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@notionhq/client": "^5.31.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
